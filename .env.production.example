# Database
DATABASE_URL=postgresql://postgres:PRODUCTION_PASSWORD@postgres:5432/finance_agent_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PRODUCTION_PASSWORD
POSTGRES_DB=finance_agent_prod

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=PRODUCTION_REDIS_PASSWORD

# API Keys
GOOGLE_GENERATIVE_AI_API_KEY=your-production-api-key
AI_API_KEY=your-production-gemini-key

# JWT/Auth
JWT_SECRET=your-production-jwt-secret
FIREBASE_PROJECT_ID=your-firebase-project-id
JWT_ISSUER=https://securetoken.google.com/your-firebase-project-id
JWT_AUDIENCE=your-firebase-project-id

# GCP
GCS_BUCKET_NAME=your-production-bucket
GCP_KMS_KEY_ID=your-kms-key-id
GCP_KMS_PROJECT_ID=your-gcp-project-id
GCP_KMS_LOCATION_ID=us-central1
GCP_KMS_KEY_RING_ID=your-key-ring

# Environment
NODE_ENV=production

# Frontend
NEXT_PUBLIC_API_URL=https://api.your-domain.com

