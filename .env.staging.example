# Database
DATABASE_URL=postgresql://postgres:STAGING_PASSWORD@postgres:5432/finance_agent_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=STAGING_PASSWORD
POSTGRES_DB=finance_agent_staging

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=STAGING_REDIS_PASSWORD

# API Keys
GOOGLE_GENERATIVE_AI_API_KEY=your-staging-api-key
AI_API_KEY=your-staging-gemini-key

# JWT/Auth
JWT_SECRET=your-staging-jwt-secret
FIREBASE_PROJECT_ID=your-firebase-project-id
JWT_ISSUER=https://securetoken.google.com/your-firebase-project-id
JWT_AUDIENCE=your-firebase-project-id

# GCP
GCS_BUCKET_NAME=your-staging-bucket
GCP_KMS_KEY_ID=your-kms-key-id
GCP_KMS_PROJECT_ID=your-gcp-project-id
GCP_KMS_LOCATION_ID=us-central1
GCP_KMS_KEY_RING_ID=your-key-ring

# Environment
NODE_ENV=staging

# Frontend
NEXT_PUBLIC_API_URL=https://staging-api.your-domain.com
