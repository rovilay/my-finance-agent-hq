{
  "name": "my-finance-agent-hq",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @hq/cli dev",
    "db:studio": "pnpm --filter @hq/cli db:studio",
    "db:generate": "pnpm --filter @hq/cli db:generate",
    "db:migrate": "pnpm --filter @hq/cli db:migrate",
    "db:push": "pnpm --filter @hq/cli db:push",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose up -d --build",
    "deploy:staging": "./scripts/deploy-staging.sh",
    "deploy:production": "./scripts/deploy-production.sh",
    "rollback:staging": "./scripts/rollback.sh staging",
    "rollback:production": "./scripts/rollback.sh production",
    "fly:setup": "./scripts/create-fly-apps.sh",
    "fly:deploy": "./scripts/deploy-fly.sh",
    "fly:deploy:staging:backend": "flyctl deploy --config apps/backend-api/fly.staging.toml",
    "fly:deploy:staging:frontend": "flyctl deploy --config apps/web-app/fly.staging.toml",
    "fly:deploy:prod:backend": "flyctl deploy --config apps/backend-api/fly.toml",
    "fly:deploy:prod:frontend": "flyctl deploy --config apps/web-app/fly.toml",
    "fly:logs:staging:backend": "flyctl logs -a finance-agent-backend-stg",
    "fly:logs:staging:frontend": "flyctl logs -a finance-agent-frontend-stg",
    "fly:logs:prod:backend": "flyctl logs -a finance-agent-backend",
    "fly:logs:prod:frontend": "flyctl logs -a finance-agent-frontend",
    "fly:status:staging": "flyctl status -a finance-agent-backend-stg",
    "fly:status:prod": "flyctl status -a finance-agent-backend",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "ai": "catalog:",
    "dotenv": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "zod": "^3.23.8"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
